# 高科 iAI 設定
IAI_API_KEY=your_iai_api_key
IAI_BASE_URL=https://www.iai.nkust.edu.tw/aihub/v1
IAI_MODEL=Furen-large

# Google API 設定 (選填：若無設定 CX 則自動使用 Google News RSS)
GOOGLE_CSE_API_KEY=your_google_api_key
GOOGLE_CSE_CX=your_google_cse_cx

# GitHub API 設定 (選填：填入可提升每分鐘搜尋上限)
GITHUB_TOKEN=your_github_token

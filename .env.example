# 高科 iAI 設定
IAI_BASE_URL=https://www.iai.nkust.edu.tw/aihub/v1

# 金鑰池：填入 4 組金鑰（逗號分隔），或改用 IAI_API_KEY_1..4
# 注意：本檔僅為範例，請勿把真實金鑰寫進被 git 追蹤的檔案；建議用系統環境變數。
IAI_API_KEYS=key1,key2,key3,key4

# 多模型設定
IAI_MODEL_MAX=Furen-max
IAI_MODEL_LARGE=Furen-large
IAI_MODEL_CODER=Furen-coder
IAI_MODEL_IMAGE=Pic-large

# 併發與重試
IAI_MAX_CONCURRENCY=6
IAI_PER_KEY_CONCURRENCY=2
IAI_TIMEOUT=120
IAI_MAX_RETRIES=3

# 時效窗（天）
NEWS_MAX_AGE_DAYS=14
PAPER_MAX_AGE_DAYS=30
REPO_MAX_AGE_DAYS=30

# 新聞來源行為
NEWS_MAX_PER_SOURCE=3
NEWS_MAX_PER_DOMAIN=4
NEWS_ROBOTS_CHECK=true
NEWS_BING_ENABLED=true
NEWS_HTTP_TIMEOUT=20
# NEWS_MAX_BYTES=5242880
# NEWS_USER_AGENT=DailyAIReportBot/2.0 (+https://github.com/ethanworkspace/daily_news_paper_tool)

# Google API 設定 (選填：若無設定 CX 則自動使用 Google News RSS)
GOOGLE_CSE_API_KEY=your_google_api_key
GOOGLE_CSE_CX=your_google_cse_cx

# GitHub API 設定 (選填：填入可提升每分鐘搜尋上限)
GITHUB_TOKEN=your_github_token

# Semantic Scholar API 設定 (選填)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key
